{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ExampleIAST Agent",
          "semanticVersion": "4.2.0",
          "informationUri": "https://iast.example.com/agent",
          "rules": [
            {
              "id": "sql-injection",
              "name": "SqlInjection",
              "shortDescription": {
                "text": "SQL injection"
              },
              "fullDescription": {
                "text": "Untrusted request data reached a SQL query without parameterization."
              },
              "help": {
                "text": "Use parameterized queries (e.g. SqlParameter or an ORM) instead of building SQL from request data.",
                "markdown": "<img src=x onerror=alert(1)> Use **parameterized** queries."
              },
              "helpUri": "https://iast.example.com/rules/sql-injection?utm_source=report#top",
              "properties": {
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "external/cwe/cwe-89"
                ]
              }
            },
            {
              "id": "reflected-xss",
              "name": "ReflectedXss",
              "shortDescription": {
                "text": "Reflected cross-site scripting"
              },
              "help": {
                "text": "Encode untrusted data for the HTML context before rendering it."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "relationships": [
                {
                  "target": {
                    "id": "79",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "weak-hash",
              "name": "WeakHashAlgorithm",
              "shortDescription": {
                "text": "Weak hash algorithm"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "nightly-integration-tests/2026-10-14"
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "webRequests": [
        {
          "protocol": "HTTP",
          "version": "1.1",
          "method": "GET",
          "target": "https://shop.test.internal:8443/api/orders/9817/items?view=full"
        }
      ],
      "results": [
        {
